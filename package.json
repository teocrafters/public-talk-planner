{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "ci": "pnpm lint && pnpm typecheck && pnpm build",
    "check:fix": "pnpm lint:fix && pnpm format",
    "db:generate": "drizzle-kit generate",
    "auth:schema": "pnpm dlx @better-auth/cli generate --config scripts/auth-cli.ts --output server/database/auth-schema.ts -y",
    "seed": "curl -X POST http://localhost:3000/_nitro/tasks/seed",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "2.0.109",
    "@internationalized/date": "3.12.4",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/ui": "4.11.3",
    "@nuxthub/core": "0.10.8",
    "@nuxtjs/i18n": "10.6.0",
    "ai": "5.0.276",
    "better-auth": "1.7.7",
    "dayjs": "1.11.23",
    "drizzle-orm": "0.45.4",
    "eslint": "9.39.5",
    "nuxt": "4.6.1",
    "resend": "6.33.0",
    "typescript": "5.9.3",
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@libsql/client": "0.18.0",
    "@playwright/test": "1.64.1",
    "@react-email/render": "2.1.0",
    "@types/node": "24.19.2",
    "adm-zip": "0.6.1",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tinyexec": "1.3.1",
    "vitest": "4.1.11",
    "wrangler": "4.151.0"
  },
  "pnpm": {
    "overrides": {
      "@simplewebauthn/server": "13.1.2",
      "@simplewebauthn/browser": "13.1.2"
    }
  }
}
