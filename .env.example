# PostgreSQL connection string, read by the server, drizzle-kit and the migration entrypoint
NUXT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/public_talk_planner

# Session signing secret — generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET=

# Base URL of your app
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare account owning the Email Service configuration, and an API token scoped to
# `Email Sending: Edit`; verification emails are only sent with NODE_ENV=production, otherwise the
# activation link is logged instead
NUXT_CLOUDFLARE_ACCOUNT_ID=
NUXT_CLOUDFLARE_EMAIL_TOKEN=

# Sender address; its domain must be onboarded as a Cloudflare sending domain
NUXT_EMAIL_FROM=noreply@zychlin.org

# Anthropic API key, required by the speaker-list import; without it every import job fails
ANTHROPIC_API_KEY=

# Directory the speaker-import uploads are written to; relative paths resolve against the working
# directory, and the container points this at its job-files volume
NUXT_JOB_FILES_DIR=.data/job-files

# Set to 1 to make the seed tasks treat this environment as staging
NUXT_SEED_STAGING=

# Same connection string again, under the name `pnpm auth:schema` reads
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/public_talk_planner
