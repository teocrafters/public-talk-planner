discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	// Dokploy deploys through Swarm, where the container name carries a task suffix that changes
	// on every restart; the service name is what stays queryable across deployments.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
		target_label  = "service"
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	labels     = {job = "docker"}
	forward_to = [loki.process.server_logs.receiver]
}

loki.process "server_logs" {
	// The application writes one JSON object per line; lines from other containers simply yield
	// no level and pass through unlabelled.
	stage.json {
		expressions = {level = "level"}
	}

	// Safe as a label because the logger emits four levels and nothing else, so stream
	// cardinality stays bounded.
	stage.labels {
		values = {level = ""}
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
